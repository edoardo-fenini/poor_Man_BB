# Free key from https://finnhub.io (Dashboard -> API key). Live US stock trades and news.
FINNHUB_KEY=
# Free key from https://etherscan.io/myapikey. Large Ethereum transfers.
ETHERSCAN_KEY=
# SEC requires a contact string, e.g. "Your Name your@email.com". Insider and fund filings.
SEC_USER_AGENT=
# Free key from https://aisstream.io (sign in with GitHub -> API Keys). Live ships on the map.
AISSTREAM_KEY=
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html. US economic statistics (ECST).
FRED_KEY=
